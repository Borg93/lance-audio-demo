# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.ruff_cache/
.pytest_cache/
.ty_cache/
.mypy_cache/
.coverage
htmlcov/

# Local agent config
.claude/

# Editor / IDE
.vscode/

# Lance datasets + transcription pipeline outputs (local-only, never committed)
*.lance/
output/
models/
input/
thumbnails/
video_batcher.csv

# Media: don't commit audio/video — examples/ is for JSON only
examples/*.mp3
examples/*.mp4
examples/*.wav
examples/*.ogg
examples/*.m4a
examples/*.flac
examples/*.mov
examples/*.webm

# Process logs go to logs/ (see Makefile $(LOG_DIR)). Keep the folder
# tracked via .gitkeep but never commit the rotating log files.
*.log*
logs/*
!logs/.gitkeep

# Node / SvelteKit (frontend + demo)
node_modules/
*/node_modules/
frontend/.svelte-kit/
frontend/build/
demo/.svelte-kit/
demo/build/
# Turborepo monorepo layout (apps/* + packages/*) — build + task-cache artifacts
**/.svelte-kit/
**/.turbo/
frontend/apps/*/build/
frontend/packages/*/dist/

# Stray local artifacts
images_per.jpg
trocr-test/results/
nohup.out
kg_work/

# Baseline capture (LANCE_MEDIA_MERGE §5.3): JSONs are committed, the Lance DB is local-only
baselines/*.lance/
