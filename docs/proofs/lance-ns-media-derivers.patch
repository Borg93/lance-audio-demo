@@ -0,0 +1,85 @@
+"""PROOF (lance-media × lance-ns): a lance-media compute stage runs as a lance-ns SILVER deriver.
+
+An AUDIO blob flows bronze → silver through the platform's UNCHANGED generic compute seam
+(``transform_stage``) and gains a lance-media ``voiceprint`` artifact — the media-lane docstring's
+"an audio deriver slots into _DERIVERS later" made real, on a REAL Lance dataset (no fakes). This is the
+day-one de-risk of "our batch stages become medallion silver derivers": if the image lane's exact harness
+works for our audio modality with only a (probe, deriver) pair added, every rmedia column-additive stage
+lands the same way.
+
+Mirrors tests/unit/test_medallion_derivers.py::test_image_blobs_derive_artifacts_through_the_generic_stage.
+"""
+
+from __future__ import annotations
+
+import io
+import math
+import wave
+from array import array
+from pathlib import Path
+
+import lance
+import pyarrow as pa
+from lance import blob_array, blob_field
+from medallion.services import media
+from medallion.services.compute import transform_stage
+
+
+def _wav(freq_hz: int, n: int = 4000, rate: int = 16000) -> bytes:
+    """A deterministic mono 16-bit PCM WAV tone — real audio bytes, no ffmpeg."""
+    samples = array("h", [int(30000 * math.sin(2 * math.pi * freq_hz * i / rate)) for i in range(n)])
+    buffer = io.BytesIO()
+    with wave.open(buffer, "wb") as handle:
+        handle.setnchannels(1)
+        handle.setsampwidth(2)
+        handle.setframerate(rate)
+        handle.writeframes(samples.tobytes())
+    return buffer.getvalue()
+
+
+def _bronze_media(tmp_path: Path, payloads: list[bytes]) -> str:
+    """The bronze-media blob-v2 table shape the ingest head writes (id, payload blob, source_uri)."""
+    uri = str(tmp_path / "bronze_media")
+    table = pa.table(
+        {
+            "id": pa.array(range(len(payloads)), pa.int64()),
+            "payload": blob_array(payloads),
+            "source_uri": pa.array([f"s3://audio/{i}" for i in range(len(payloads))], pa.string()),
+        },
+        schema=pa.schema(
+            [pa.field("id", pa.int64()), blob_field("payload"), pa.field("source_uri", pa.string())]
+        ),
+    )
+    lance.write_dataset(table, uri, mode="overwrite", data_storage_version="2.2")
+    return uri
+
+
+def test_audio_blobs_derive_voiceprint_through_the_generic_stage(tmp_path: Path) -> None:
+    """The media lane needs NO special mover for audio either: the SAME generic stage derives a voiceprint
+    from audio content — proving a lance-media stage slots into the cascade as a silver deriver."""
+    bronze = _bronze_media(tmp_path, [_wav(220), _wav(880)])
+    silver = str(tmp_path / "silver_media")
+
+    result = transform_stage(bronze, silver, {}, stage="silver-media")
+
+    ds = lance.dataset(silver)
+    # The audio artifact landed; the image artifacts did NOT (content-dispatched, not config-driven).
+    assert "voiceprint" in ds.schema.names
+    assert "thumbnail" not in ds.schema.names and "embedding" not in ds.schema.names
+    # Blob carried forward intact at file format 2.2, original still a blob.
+    assert ds.data_storage_version == "2.2"
+    assert ds.schema.field("payload").type.extension_name == "lance.blob.v2"
+    # source_uri provenance + the stage stamp survive (the DERIVED_FROM inputs / stage column).
+    assert ds.to_table(columns=["source_uri"]).column("source_uri").to_pylist() == [
+        "s3://audio/0",
+        "s3://audio/1",
+    ]
+    assert ds.to_table(columns=["stage"]).column("stage").to_pylist() == ["silver-media", "silver-media"]
+    # The voiceprints are real, content-derived, fixed-size, and differ by audio content.
+    voiceprints = ds.to_table(columns=["voiceprint"]).column("voiceprint").to_pylist()
+    assert all(len(v) == media.AUDIO_EMBEDDING_DIMS for v in voiceprints)
+    assert voiceprints[0] != voiceprints[1]  # 220 Hz vs 880 Hz → different voiceprints
+    # The lineage WROTE-edge schema facet records the derived column as a Lance array type.
+    facet_types = {f["name"]: f["type"] for f in result.fields}
+    assert facet_types["payload"] == "blob"
+    assert facet_types["voiceprint"].startswith("array")
