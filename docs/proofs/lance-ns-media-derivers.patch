+def transform_stage_fanout(
+    from_uri: str, to_uri: str, storage_options: dict[str, str], *, stage: str
+) -> tuple[WriteResult, dict[str, WriteResult]]:
+    """PROTOTYPE (lance-media docs/LANCE_NS_INTEGRATION.md §4, model 2): ``transform_stage`` + FAN-OUT.
+
+    Identical to :func:`transform_stage` for the primary silver table, but ALSO writes any sibling tables a
+    fan-out deriver emits (video → one ``frames`` row per extracted frame) to ``f"{to_uri}__{name}"`` at the
+    same 2.2 + stable-row-id contract, each frame keyed to its parent by ``source_rowid``. Additive: when no
+    fan-out deriver matches (image / audio / tabular), the siblings map is empty and this is byte-identical
+    to ``transform_stage``. Proves the column-additive deriver contract extends to new-table stages
+    (``extract_frames`` / ``diarize`` / ``voiceprint`` → ``speaker_turns``) with NO change to the mover,
+    cascade, lineage, or gates — only a parallel registry.
+    """
+    ds = lance.dataset(from_uri, storage_options=storage_options)
+    out, blob_payloads = _carry_forward(ds, stage)
+    primary = derive_artifacts(out, blob_payloads)
+    lance.write_dataset(
+        primary,
+        to_uri,
+        mode="overwrite",
+        storage_options=storage_options,
+        data_storage_version="2.2",
+        enable_stable_row_ids=True,
+    )
+    primary_result = measure(to_uri, storage_options)
+    primary_result.column_map = _column_map(ds.schema, primary.column_names, set(blob_payloads))
+    siblings: dict[str, WriteResult] = {}
+    for name, child in derive_fanout(out, blob_payloads).items():
+        sibling_uri = f"{to_uri}__{name}"
+        lance.write_dataset(
+            child,
+            sibling_uri,
+            mode="overwrite",
+            storage_options=storage_options,
+            data_storage_version="2.2",
+            enable_stable_row_ids=True,
+        )
+        siblings[name] = measure(sibling_uri, storage_options)
+    return primary_result, siblings
+
