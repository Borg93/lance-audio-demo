+# ── lance-media AUDIO lane (the "an audio deriver slots into _DERIVERS later" extension) ──────────────
+def is_audio(payload: bytes) -> bool:
+    """Whether ``payload`` DECODES as WAV audio — the content probe for voiceprint derivation.
+
+    Symmetric with :func:`is_image` (which verifies, not just sniffs magic): a RIFF/WAVE header alone is
+    not enough — the fmt chunk must actually parse — so a blob that merely *starts* like a WAV but is not
+    valid audio is correctly "not audio" and carries through untouched. Extend with more codecs as more
+    audio derivers land.
+    """
+    if not (len(payload) >= 12 and payload[:4] == b"RIFF" and payload[8:12] == b"WAVE"):
+        return False
+    try:
+        with wave.open(io.BytesIO(payload)) as handle:
+            handle.getnframes()
+    except Exception:  # noqa: BLE001 — any decode failure means "not (valid) audio", never an error
+        return False
+    return True
+
+
+def is_video(payload: bytes) -> bool:
+    """Whether ``payload`` is ISO-BMFF/MP4 video — the content probe for the frame-extraction FAN-OUT.
+
+    ISO base media format marks the ``ftyp`` box at bytes 4:8. A real deriver would decode keyframes;
+    the model-free stand-in (``derivers._video_frames``) segments the bytes deterministically instead —
+    same "prove the plumbing without a heavy dep" trick as the image/audio derivers.
+    """
+    return len(payload) >= 12 and payload[4:8] == b"ftyp"
+
+
+def derive_voiceprint(audio_bytes: bytes, dims: int = AUDIO_EMBEDDING_DIMS) -> list[float]:
+    """A deterministic ``dims``-length speaker feature — the 16-bit PCM samples' mean-magnitude in ``dims``
+    time buckets. Real audio-content-derived features (the model-free stand-in a WeSpeaker/pyannote
+    voiceprint swaps into in prod), so silver's voiceprint actually depends on the media — no ML dep.
+    """
+    with wave.open(io.BytesIO(audio_bytes)) as handle:
+        frames = handle.readframes(handle.getnframes())
+    samples = array("h")
+    samples.frombytes(frames[: len(frames) - (len(frames) % samples.itemsize)])
+    if not samples:
+        return [0.0] * dims
+    bucket = max(1, len(samples) // dims)
+    return [
+        sum(abs(s) for s in (samples[i * bucket : (i + 1) * bucket] or samples[-bucket:]))
+        / len(samples[i * bucket : (i + 1) * bucket] or samples[-bucket:])
+        / 32768.0
+        for i in range(dims)
+    ]
