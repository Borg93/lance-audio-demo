@@ -0,0 +1,79 @@
+"""PROOF (lance-media × lance-ns §4, model 2): a FAN-OUT compute stage runs as a lance-ns silver deriver.
+
+The column-additive ``Deriver`` cannot express a stage that emits a NEW table with a different row
+cardinality — our ``extract_frames`` (1 video → N frame rows), ``diarize`` (1 doc → N speaker turns),
+``voiceprint`` (N turns → N vectors). This proves the small, additive extension (a ``_FANOUT_DERIVERS``
+registry + ``derive_fanout`` + ``transform_stage_fanout``) makes those stages first-class: a video blob
+flows bronze → silver through the platform's primitives and produces BOTH the carried primary silver table
+AND a sibling ``frames`` table with correct fan-out cardinality + parent provenance — on REAL Lance
+datasets, with NO change to the mover / cascade / lineage / gates.
+
+Mirrors tests/unit/test_medallion_derivers.py; companion to test_lance_media_audio_deriver.py.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import lance
+import pyarrow as pa
+from lance import blob_array, blob_field
+from medallion.services.compute import transform_stage_fanout
+
+
+def _mp4(marker: bytes, body_len: int = 300) -> bytes:
+    """A minimal ISO-BMFF/MP4 blob: a real ``ftyp`` box header + a marker-filled body (distinct per video
+    so extracted frames differ). ``is_video`` keys on the ftyp box at bytes 4:8."""
+    header = b"\x00\x00\x00\x18ftypisom\x00\x00\x02\x00isomiso2"
+    return header + (marker * body_len)[:body_len]
+
+
+def _bronze_media(tmp_path: Path, payloads: list[bytes]) -> str:
+    uri = str(tmp_path / "bronze_media")
+    table = pa.table(
+        {
+            "id": pa.array(range(len(payloads)), pa.int64()),
+            "payload": blob_array(payloads),
+            "source_uri": pa.array([f"s3://video/{i}" for i in range(len(payloads))], pa.string()),
+        },
+        schema=pa.schema(
+            [pa.field("id", pa.int64()), blob_field("payload"), pa.field("source_uri", pa.string())]
+        ),
+    )
+    lance.write_dataset(table, uri, mode="overwrite", data_storage_version="2.2")
+    return uri
+
+
+def test_video_blob_fans_out_to_a_frames_sibling_table(tmp_path: Path) -> None:
+    """One video row → N frame rows in a sibling silver table, keyed to the parent — model-2 fan-out."""
+    bronze = _bronze_media(tmp_path, [_mp4(b"A"), _mp4(b"B")])
+    silver = str(tmp_path / "silver_media")
+
+    primary, siblings = transform_stage_fanout(bronze, silver, {}, stage="silver-media")
+
+    # PRIMARY silver: the video blob carried forward untouched (not image/audio → no artifact column).
+    primary_ds = lance.dataset(silver)
+    assert primary.row_count == 2
+    assert "voiceprint" not in primary_ds.schema.names
+    assert "thumbnail" not in primary_ds.schema.names and "embedding" not in primary_ds.schema.names
+    assert primary_ds.schema.field("payload").type.extension_name == "lance.blob.v2"
+
+    # FAN-OUT: a NEW sibling table with N frames per parent, blob-v2, at file format 2.2.
+    assert set(siblings) == {"frames"}
+    frames_ds = lance.dataset(f"{silver}__frames")
+    assert frames_ds.data_storage_version == "2.2"
+    assert frames_ds.count_rows() == 6  # 2 videos × 3 frames
+    assert siblings["frames"].row_count == 6
+    assert frames_ds.schema.field("frame").type.extension_name == "lance.blob.v2"
+
+    # Parent provenance survives the fan-out: each frame names its source row (root _rowid) + parent id.
+    keys = frames_ds.to_table(columns=["parent_source_rowid", "parent_id", "frame_idx"])
+    assert keys.column("parent_source_rowid").to_pylist() == [0, 0, 0, 1, 1, 1]
+    assert keys.column("parent_id").to_pylist() == [0, 0, 0, 1, 1, 1]
+    assert keys.column("frame_idx").to_pylist() == [0, 1, 2, 0, 1, 2]
+
+    # The frame blobs are real, content-derived, and differ across the two source videos.
+    frame_of_video_a = frames_ds.read_blobs("frame", indices=[0])[0][1]
+    frame_of_video_b = frames_ds.read_blobs("frame", indices=[3])[0][1]
+    assert frame_of_video_a and frame_of_video_b
+    assert frame_of_video_a != frame_of_video_b
